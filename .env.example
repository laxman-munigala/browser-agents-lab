# Copy to .env (gitignored). API keys can live here or in ~/.bashrc as
# `export KEY=...`; common/config.py reads both.
# BROWSER_USE_API_KEY=bu_...        # L2 (cloud browser), L4 (cloud agent)
# TINYFISH_API_KEY=...              # L0 (search/fetch), L2 (browser), L4 (agent)
# OPENROUTER_API_KEY=sk-or-...      # L3, L4 local agent, L6
# GITHUB_TOKEN=...                  # optional: raises the checker's GitHub API limit

# The mock app. The deployed Worker, or http://localhost:8787 with `pnpm dev`.
MOCK_APP_URL=https://browser-agents-mock.laxman-225.workers.dev
# Must equal the Worker's secret (wrangler secret put RECEIPT_SECRET) and
# mock-app/.dev.vars, or the checker can't verify receipts.
RECEIPT_SECRET=change-me

# Model for every level that calls an LLM itself (via OpenRouter).
LAB_LLM_MODEL=deepseek/deepseek-v4.1-flash

# Local Chrome over CDP (common/cdp_discovery.py): a clean profile, never
# seeded with your everyday Chrome's cookies. Don't set BU_CDP_WS here.
BU_CDP_PROFILE=~/.config/google-chrome-cdp-lab
BU_CDP_SEED=0
